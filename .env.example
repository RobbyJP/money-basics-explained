# Gemini API key for content generation (free tier: aistudio.google.com/apikey)
GEMINI_API_KEY=your_key_here
# Free-tier friendly model (adjust if your tier excludes it)
GEMINI_MODEL=gemini-3.5-flash

# Site metadata
SITE_NAME=Money Basics Explained
SITE_URL=https://yourdomain.com
SITE_DESCRIPTION=Clear explanations of personal finance concepts and honest comparisons of common tools and strategies.

# Publishing
GIT_REMOTE_BRANCH=main
PUBLIC_DIR=public
